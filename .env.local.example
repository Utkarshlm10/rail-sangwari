# Rail Sangwari (रेल संगवारी) Environment Configuration
# All configurations are 100% OPTIONAL. The app works out of the box with SECR Local Mesh engine.

# ----------------------------------------------------
# 1. OPTIONAL: Firebase Cloud Firestore & FCM Web Push
# ----------------------------------------------------
# Create a free project at https://console.firebase.google.com
# Enable Firestore Database (Spark Free Plan)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ----------------------------------------------------
# 2. OPTIONAL: RapidAPI Indian Railways Live PNR API
# ----------------------------------------------------
# If not set, falls back to SECR verified demo PRS records (BSP, R, DURG)
RAILWAY_API_KEY=YOUR_RAPIDAPI_KEY
RAILWAY_API_HOST=irctc1.p.rapidapi.com
